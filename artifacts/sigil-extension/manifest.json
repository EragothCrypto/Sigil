{
  "manifest_version": 3,
  "name": "Sigil — Web3 Trust Layer",
  "version": "1.0.0",
  "description": "Real-time transaction risk analysis. Understand what you're signing before you sign it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sigil — Web3 Trust Layer"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "overlay.html", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.replit.dev/*",
    "https://*.replit.app/*"
  ]
}
