{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm --filter @workspace/api-server build && pnpm --filter @workspace/sigil build",
  "outputDirectory": "dist/public",
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
    ]
  }],
  "crons": [{ "path": "/api/sigil/maintenance/retention", "schedule": "17 3 * * *" }],
  "rewrites": [
    {
      "source": "/api/sigil/monitor/v2/solana/scan",
      "destination": "/api?solanaWalletCheck=1"
    },
    {
      "source": "/api/sigil/simulate-v2",
      "destination": "/api/sigil/simulate?executionCheckVersion=2"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
