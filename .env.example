# Sigil production/local environment template.
# Copy to .env for local development. Do not commit real secrets.

# Required for local Express server runs. Vercel provides its own port.
PORT=3001

# Required: PostgreSQL connection string used by the runtime API.
# For Neon on Vercel, use the pooled connection string, usually with "-pooler" in the host.
# Explicit certificate/hostname verification; do not use libpq require/no-verify compatibility.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# Optional but recommended for schema pushes/migrations.
# Use the direct/unpooled Neon connection string here.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=verify-full

# Optional serverless pool tuning for node-postgres.
DATABASE_POOL_MAX=3
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Required: OpenAI-compatible API endpoint and key.
# Sigil is configured for OpenRouter by default.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-or-v1-replace_me

# Required for AI analysis model selection.
# Paid model: configure an OpenRouter key spending limit before production use.
SIGIL_AI_MODEL=deepseek/deepseek-v4-flash

# Optional: improves Etherscan rate limits for transaction/contract lookups.
ETHERSCAN_API_KEY=

# Optional API security controls.
# Add comma-separated production/preview frontend origins if they differ from the defaults.
SIGIL_ALLOWED_ORIGINS=https://sigil.s3ntrylabs.com
SIGIL_RATE_LIMIT_WINDOW_MS=60000
SIGIL_RATE_LIMIT_MAX=60

# Eligibility age for ordinary analysis deletion; daily cron/scheduler required.
# Standalone Express deployments must configure an external scheduler.
SIGIL_ANALYSIS_RETENTION_DAYS=30

# Required in production for the daily Vercel retention job. Use a random secret.
CRON_SECRET=

# Optional logging.
LOG_LEVEL=info
