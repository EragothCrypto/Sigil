# Sigil production/local environment template.
# Copy to .env for local development. Do not commit real secrets.

# Required for local Express server runs. Vercel provides its own port.
PORT=3001

# Required: PostgreSQL connection string used by Drizzle.
# For Vercel, create a Postgres database or provide another hosted Postgres URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Required: OpenAI-compatible API endpoint and key.
# Sigil is configured for OpenRouter by default.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-or-v1-replace_me

# Required for AI analysis model selection.
SIGIL_AI_MODEL=deepseek/deepseek-v4-flash:free

# Optional: improves Etherscan rate limits for transaction/contract lookups.
ETHERSCAN_API_KEY=

# Optional logging.
LOG_LEVEL=info
