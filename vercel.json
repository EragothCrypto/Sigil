{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/sigil build",
  "outputDirectory": "artifacts/sigil/dist/public",
  "crons": [{ "path": "/api/sigil/maintenance/retention", "schedule": "17 3 * * *" }],
  "rewrites": [
    {
      "source": "/api/sigil/simulate-v2",
      "destination": "/api/sigil/simulate?executionCheckVersion=2"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
